      "checkConstraints": {
        "goal_target_and_rate": {
          "name": "goal_target_and_rate",
          "value": "(\"goal\".\"type\" in ('lose', 'gain')) = (\"goal\".\"target_weight_kg\" is not null and \"goal\".\"weekly_rate_pct\" is not null)"
        },
        "goal_target_with_rate": {
          "name": "goal_target_with_rate",
          "value": "(\"goal\".\"target_weight_kg\" is null) = (\"goal\".\"weekly_rate_pct\" is null)"
        },
        "goal_rate_range": {
          "name": "goal_rate_range",
          "value": "\"goal\".\"weekly_rate_pct\" is null\n        or (\"goal\".\"type\" = 'lose' and \"goal\".\"weekly_rate_pct\" between 0.25 and 1.5)\n        or (\"goal\".\"type\" = 'gain' and \"goal\".\"weekly_rate_pct\" between 0.1 and 0.75)"
        },
        "goal_weight_range": {
          "name": "goal_weight_range",
          "value": "\"goal\".\"start_weight_kg\" between 20 and 400\n        and (\"goal\".\"target_weight_kg\" is null or \"goal\".\"target_weight_kg\" between 20 and 400)"
        },
        "goal_ended_at": {
          "name": "goal_ended_at",
          "value": "(\"goal\".\"status\" = 'active') = (\"goal\".\"ended_at\" is null)"
        }
      },
